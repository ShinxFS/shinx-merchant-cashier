# Copy these server-only values into .env.local and your Vercel project settings.
# Never prefix the service-role key or token secret with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TABLE_QR_TOKEN_SECRET=

# Server 1 uses a separate Supabase project and separate QR credentials.
NEXT_PUBLIC_SUPABASE_URL_1=
NEXT_PUBLIC_SUPABASE_ANON_KEY_1=
SUPABASE_SERVICE_ROLE_KEY_1=
TABLE_QR_TOKEN_SECRET_1=

# Generate a random secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
